vcl 4.1;

import std;
${GEOIP_ENABLED-false}

backend default {
    .host = "${BACKEND_HOST-traefik}";
    .port = "${BACKEND_PORT-80}";
    .first_byte_timeout = 300s;
    .between_bytes_timeout = 300s;
}

sub vcl_recv {
    # Purge handling
    if (req.method == "PURGE") {
        if (client.ip !~ purge_acl) {
            return (synth(405, "Method not allowed"));
        }
        return (purge);
    }

    # Normalise Host header (remove CDN prefix for origin)
    set req.http.Host = regsub(req.http.Host, "^cdn\.", "");

    # GeoIP simulation (if enabled)
    if (req.http.X-GeoIP-Country) {
        if (req.http.X-GeoIP-Country == "US") {
            set req.backend_hint = us_backend;
        } else {
            set req.backend_hint = default;
        }
    }

    # Do not cache admin pages, etc.
    if (req.url ~ "^/(admin|api)") {
        return (pass);
    }

    # Cache everything else for 1 hour
    return (hash);
}

sub vcl_backend_response {
    set beresp.ttl = 1h;
    set beresp.http.Cache-Control = "public, max-age=3600";
    set beresp.http.X-Cache-Status = "MISS";
}

sub vcl_deliver {
    if (obj.hits > 0) {
        set resp.http.X-Cache-Status = "HIT";
    } else {
        set resp.http.X-Cache-Status = "MISS";
    }
}

acl purge_acl {
    "127.0.0.1";
    "172.0.0.0/8";
}