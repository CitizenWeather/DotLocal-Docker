# NetLocal Caddy Gateway
# Handles automatic HTTPS using internal CA

{
    # Use internal CA for *.net.local
    local_ca http://ca.net.local/acme/acme/directory
}

*.${NETLOCAL_ROOT_DOMAIN:-net.local} {
    tls {
        issuer acme {
            ca http://ca.net.local/acme/acme/directory
        }
    }
    reverse_proxy /* {{ .Upstream }}:{{ .Port }}
}

# Dashboard for Caddy itself
caddy.${NETLOCAL_ROOT_DOMAIN:-net.local} {
    tls internal
    import /etc/caddy/admin.api
}