# NetLocal environment configuration
# Copy this file to .env before running `make bootstrap`

# =============================================================================
# Network
# =============================================================================

# The local TLD for all services (e.g. .localnet → service.localnet)
NETLOCAL_ROOT_DOMAIN=.localnet

# CIDR for the internal backbone network (infrastructure-only, no internet)
# DNS, CA, and registry get static IPs within this range
NETLOCAL_SUBNET_BACKBONE=169.254.0.0/16

# CIDR for the default application network (internet-facing, through gateway)
NETLOCAL_SUBNET_DEFAULT=172.20.0.0/16

# =============================================================================
# Swappable slots — pick one implementation per role
# =============================================================================

# DNS resolver (handles the .local zone and forwards other queries to registry)
# Options: coredns | bind9 | knot
DNS_APP=coredns

# Certificate authority (issues TLS certs via ACME for gateway and services)
# Options: smallstep | openxpki | vault-pki
CA_APP=smallstep

# DNS registry / authoritative nameserver (stores dynamic DNS records)
# Options: powerdns
REGISTRY_APP=powerdns

# Reverse proxy / API gateway (terminates TLS and routes to services)
# Options: caddy | traefik
GATEWAY_APP=caddy

# Relational database (used by PowerDNS registry and optional services)
# Options: postgres | mysql
DB_APP=postgres

# Cache layer
# Options: redis | redis-stack (redis-stack adds JSON, search, and time series modules)
CACHE_APP=redis-stack

# Object storage (S3-compatible)
# Options: minio | seaweedfs
STORAGE_APP=minio

# Message broker
# Options: nats | kafka | rabbitmq | redpanda
MESSAGING_APP=nats

# Network policy enforcement
# Options: opa | iptables
POLICY_APP=opa

# =============================================================================
# Email tiers (additive/layered — not a slot)
#
# Unlike the slots above, EMAIL_TIER stacks services progressively.
# Each tier is a superset of the one below it:
#   1 = Mailpit only (dev trap, captures all outbound mail, no real delivery)
#   2 = Stalwart full mail server + SnappyMail webmail
#   3 = tier 2 + Dovecot IMAP
#   4 = tier 3 + Postfix relay (enables real outbound delivery)
# =============================================================================
EMAIL_TIER=1

# =============================================================================
# Observability
# =============================================================================

# Set to true to start Prometheus, Grafana, Loki, Promtail, and Tempo
ENABLE_OBSERVABILITY=false

# =============================================================================
# Extensions
# =============================================================================

# Space-separated list of extension tags to activate.
# Each tag enables an extension pack from extensions/tags/<tag>/docker-compose.yml
# Available tags: iot | chaos | legacy | labs
# Example: EXTENSION_TAGS=iot chaos
EXTENSION_TAGS=

# =============================================================================
# Secrets — change all of these before use
# =============================================================================

# PostgreSQL
POSTGRES_PASSWORD=changeme

# PowerDNS API key (used by register-service.sh and the DNS registry)
POWERDNS_API_KEY=changeme

# MinIO object storage credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme

# ChirpStack database password (only needed when iot extension is active)
CHIRPSTACK_DB_PASSWORD=changeme
