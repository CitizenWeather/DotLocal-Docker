# ─── NetLocal Configuration ───────────────────────────────────────────────────
# Copy this file to .env and edit as needed before running `make bootstrap`.
# .env is gitignored — never commit it.

# ─── Network ─────────────────────────────────────────────────────────────────

# Root domain for all local services (e.g. grafana.net.local, ca.net.local)
NETLOCAL_ROOT_DOMAIN=net.local

# Docker network subnets — do not overlap with your LAN or each other
NETLOCAL_SUBNET_BACKBONE=169.254.0.0/16
NETLOCAL_SUBNET_DEFAULT=172.20.0.0/16

# ─── Swappable components ─────────────────────────────────────────────────────

# DNS server
# Options: coredns | bind9 | knot
DNS_APP=coredns

# Certificate Authority
# Options: smallstep | openxpki | vault-pki
CA_APP=smallstep

# DNS/DHCP registry (service discovery)
# Options: powerdns | knot-dns
REGISTRY_APP=powerdns

# Policy engine (optional — leave blank to disable)
# Options: opa | iptables
POLICY_APP=

# API Gateway / reverse proxy
# Options: caddy | traefik
GATEWAY_APP=traefik

# Relational database
# Options: postgres | mysql
DB_APP=postgres

# Cache
# Options: redis | redis-stack
CACHE_APP=redis

# Object storage
# Options: minio | seaweedfs
STORAGE_APP=minio

# Message broker
# Options: nats | nats-jetstream | kafka
MESSAGING_APP=nats

# ─── Email ────────────────────────────────────────────────────────────────────

# Email tier (leave blank to disable email entirely)
#   1 = Mailpit only (dev SMTP capture, no real delivery)
#   2 = Stalwart + SnappyMail webmail (full local MTA)
#   3 = Tier 2 + Dovecot IMAP
#   4 = Tier 3 + Postfix relay to external SMTP
EMAIL_TIER=1

# ─── Observability ────────────────────────────────────────────────────────────

# Enable Prometheus + Grafana + Loki + Promtail + Tempo
ENABLE_OBSERVABILITY=false

# Grafana admin credentials (only used when ENABLE_OBSERVABILITY=true)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ─── Extensions ──────────────────────────────────────────────────────────────

# Space-separated list of extension tags to enable
# Options: iot | chaos | labs | legacy
# Example: EXTENSION_TAGS=iot labs
EXTENSION_TAGS=

# ─── Service credentials ──────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_PASSWORD=changeme

# PowerDNS API key (used for DNS record management via REST API)
POWERDNS_API_KEY=changeme

# MinIO root credentials
MINIO_ROOT_USER=netlocal
MINIO_ROOT_PASSWORD=changeme
# CDN Provider
CDN_BACKEND_HOST=traefik
CDN_BACKEND_PORT=80
CDN_GEOIP_ENABLED=false
VARNISH_SIZE=256M

PLEROMA_DB_PASSWORD=change_me_pleroma

# OpenBao
OPENBAO_ROOT_TOKEN=root